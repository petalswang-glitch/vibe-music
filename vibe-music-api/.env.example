APP_ENV=development
DATABASE_URL=postgresql+asyncpg://vibe:vibe_local_dev@127.0.0.1:25432/vibe_music
REDIS_URL=redis://127.0.0.1:26379/0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MINIO_ENDPOINT=127.0.0.1:29000
MINIO_ACCESS_KEY=vibe_local_media
MINIO_SECRET_KEY=vibe_local_media_dev_only
MINIO_SECURE=false
MINIO_BUCKET=vibe-music-data
MINIO_REGION=us-east-1
# Generate and persist a random secret (at least 32 characters); never commit it.
# AUTH_SECRET=
SMTP_HOST=127.0.0.1
SMTP_PORT=21025
SMTP_FROM=Vibe Music <noreply@vibe.example>
SMTP_START_TLS=false
SMTP_USE_TLS=false
# Users configure their own model provider/name/API Key in the personal center.
# Do not configure a shared MODEL_API_KEY: Agent HTTP endpoints never use it.
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_TOKENS=2048
AGENT_HISTORY_SECONDS=604800
AGENT_OWNER_CONCURRENCY=2
AGENT_GLOBAL_CONCURRENCY=8
# Private Fernet key: generate once and keep with database backups, never commit it.
# AGENT_KEY_ENCRYPTION_KEY=
